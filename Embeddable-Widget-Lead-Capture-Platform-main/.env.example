ENVIRONMENT=development
BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/flyrank
JWT_SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
RATE_LIMIT=5/minute
GEO_PROVIDER_A_URL=http://ip-api.com/json/{ip}
GEO_PROVIDER_B_URL=https://ipapi.co/{ip}/json/
# real | mock_up | mock_down
GEO_PROVIDER_A_MODE=mock_up
GEO_PROVIDER_B_MODE=mock_up
SIDE_EFFECT_MODE=console
SIDE_EFFECT_FAIL=false
JOB_POLL_SECONDS=2
MAX_PAYLOAD_BYTES=16384
CONFIG_CACHE_SECONDS=60
WIDGET_CACHE_SECONDS=31536000
GEO_TIMEOUT_SECONDS=3
MAX_JOB_ATTEMPTS=3
